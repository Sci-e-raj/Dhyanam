<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_large"
        android:paddingTop="@dimen/space_medium"
        android:paddingBottom="@dimen/space_small">

        <TextView
            android:id="@+id/screen_title"
            style="@style/FocusBuddyTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true" />

        <Button
            android:id="@+id/settings_button"
            style="@style/FocusBuddyTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_target"
            android:text="@string/settings_title" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/screen_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_small"
        android:paddingVertical="@dimen/space_small">

        <Button
            android:id="@+id/nav_today"
            style="@style/FocusBuddyNavButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/today_title" />

        <Button
            android:id="@+id/nav_focus"
            style="@style/FocusBuddyNavButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/focus_title" />

        <Button
            android:id="@+id/nav_progress"
            style="@style/FocusBuddyNavButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/progress_title" />
    </LinearLayout>
</LinearLayout>
