<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_large"
        android:paddingTop="@dimen/space_small"
        android:paddingBottom="@dimen/space_xlarge">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_yellow_card"
            android:orientation="vertical"
            android:padding="@dimen/space_large">

            <TextView
                style="@style/FocusBuddyHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/blocking_card_title" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/block_shorts_switch"
                style="@style/FocusBuddyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:minHeight="@dimen/touch_target"
                android:text="@string/block_shorts_switch" />

            <TextView
                style="@style/FocusBuddyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/blocking_explanation" />

            <TextView
                android:id="@+id/blocking_service_note"
                style="@style/FocusBuddyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:text="@string/blocking_needs_service"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_large">

            <TextView
                style="@style/FocusBuddyHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/accessibility_settings_title" />

            <TextView
                android:id="@+id/accessibility_status"
                style="@style/FocusBuddyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:text="@string/accessibility_status_disabled" />

            <TextView
                style="@style/FocusBuddyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:text="@string/accessibility_explanation" />

            <TextView
                style="@style/FocusBuddyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:text="@string/accessibility_debug_explanation" />

            <TextView
                style="@style/FocusBuddyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:text="@string/accessibility_limitations" />

            <Button
                android:id="@+id/open_accessibility_settings_button"
                style="@style/FocusBuddyActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_large"
                android:text="@string/open_accessibility_settings" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
