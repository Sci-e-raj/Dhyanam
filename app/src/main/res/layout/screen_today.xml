<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_large"
        android:paddingTop="@dimen/space_small"
        android:paddingBottom="@dimen/space_xlarge">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_yellow_card"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="@dimen/space_large">

            <ImageView
                android:layout_width="@dimen/mascot_size"
                android:layout_height="@dimen/mascot_size"
                android:contentDescription="@string/mascot_description"
                android:src="@drawable/star_mascot" />

            <TextView
                style="@style/FocusBuddyHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/today_greeting" />

            <TextView
                style="@style/FocusBuddyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/today_greeting_detail" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_large">

            <TextView
                style="@style/FocusBuddyHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/daily_progress_title" />

            <TextView
                style="@style/FocusBuddyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/daily_progress_empty" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_large">

            <TextView
                style="@style/FocusBuddyHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/quests_title" />

            <TextView
                style="@style/FocusBuddyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/quests_empty" />

            <Button
                android:id="@+id/add_quest_button"
                style="@style/FocusBuddyActionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:text="@string/add_quest" />

            <TextView
                style="@style/FocusBuddyCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/add_quest_unavailable" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
