<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_large"
        android:paddingTop="@dimen/space_small"
        android:paddingBottom="@dimen/space_xlarge">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_large">

            <TextView
                style="@style/FocusBuddyCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/focus_task_label" />

            <TextView
                style="@style/FocusBuddyHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/focus_no_task" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:background="@drawable/bg_purple_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_large">

            <TextView
                style="@style/FocusBuddyHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:accessibilityHeading="true"
                android:text="@string/focus_timer_label" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:gravity="center"
                android:text="@string/focus_timer_placeholder"
                android:textColor="@color/ink"
                android:textSize="52sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FocusBuddyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:gravity="center"
                android:text="@string/focus_timer_note" />
        </LinearLayout>

        <Button
            android:id="@+id/start_focus_button"
            style="@style/FocusBuddyActionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:text="@string/start_focus" />

        <TextView
            style="@style/FocusBuddyCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:text="@string/start_focus_unavailable" />
    </LinearLayout>
</ScrollView>
