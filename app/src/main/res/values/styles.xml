<resources>
    <style name="FocusBuddyTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="FocusBuddyHeading">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="FocusBuddyBody">
        <item name="android:textColor">@color/muted_ink</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="FocusBuddyCaption">
        <item name="android:textColor">@color/muted_ink</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="FocusBuddyStatus">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="FocusBuddyQuestCheckBox">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
    </style>
    <style name="FocusBuddyActionButton">
        <item name="android:background">@drawable/bg_action_button</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:paddingHorizontal">@dimen/space_large</item>
    </style>
    <style name="FocusBuddyTextButton">
        <item name="android:background">@drawable/bg_text_button</item>
        <item name="android:textColor">@color/green_dark</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">@dimen/space_medium</item>
    </style>
    <style name="FocusBuddyNavButton">
        <item name="android:background">@drawable/bg_nav_button</item>
        <item name="android:textColor">@color/green_dark</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/nav_target</item>
        <item name="android:paddingHorizontal">@dimen/space_small</item>
    </style>
</resources>
